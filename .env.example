# DMflow Instagram Automation Platform — Environment Variables

# 1. Supabase Client & Admin Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Meta Instagram Business Login OAuth Credentials
NEXT_PUBLIC_INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
NEXT_PUBLIC_INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/callback

# 3. Meta Instagram Webhook Handshake & Verification Token
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=dmflow_secret_token_123

# 4. Gemini AI API Key (Gemini 1.5 Flash)
GEMINI_API_KEY=your_free_gemini_api_key

# 5. Session Signing Secret (required — generate with: openssl rand -base64 32)
SESSION_SECRET=

# 6. Owner Authentication Passphrase (required — use a high-entropy secret, e.g. openssl rand -base64 32)
OWNER_PASSPHRASE=
